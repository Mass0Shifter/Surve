{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "NSurvey PRO",
  "version": "1.0.0",
  "identifier": "com.nsurvey.geomatics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NSurvey PRO — Geomatics & Cadastral Computation Suite",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["nsurv"],
        "name": "NSurvey Single Project Bundle",
        "description": "NSurvey Native Cadastral Survey Project",
        "role": "Editor"
      },
      {
        "ext": ["nsurvpack"],
        "name": "NSurvey Multi-Project Pack",
        "description": "NSurvey Multi-Project Cadastral Archive",
        "role": "Editor"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
