# ── Browser (public, baked into the build) ─────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Ed25519 public key (32 bytes, base64url) used to verify offline licences
VITE_LICENSE_PUBLIC_KEY=

# ── Server only (Vercel → Project → Settings → Environment Variables) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=sk_test_xxx
# Ed25519 private key in PKCS#8 PEM (\n-escaped is fine)
LICENSE_PRIVATE_KEY=
# Optional: canonical site URL used for the Paystack return address
APP_URL=https://your-domain
